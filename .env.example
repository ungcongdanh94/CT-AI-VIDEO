# --- Database (Railway PostgreSQL plugin gives you this automatically) ---
DATABASE_URL="postgresql://user:password@host:5432/ct_ai_video"

# --- OpenAI ---
OPENAI_API_KEY="sk-..."
# Point these at whatever models your account has access to.
OPENAI_TEXT_MODEL="gpt-4o"
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
OPENAI_TTS_VOICE="alloy"

# --- Cloudinary (used for the upload step) ---
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# --- FFmpeg binaries (leave as-is if ffmpeg/ffprobe are on PATH, e.g. via the Dockerfile) ---
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"

PORT=3000
